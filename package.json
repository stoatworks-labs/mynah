{
  "name": "mynah",
  "version": "1.3.3",
  "private": true,
  "type": "module",
  "description": "A lighting-desk command line for Analog Way LivePremier switchers \u2014 type Store, Recall and Take instead of hunting for a button.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler deploy",
    "serve:dist": "python3 scripts/serve-dist.py --dir dist --port 4321",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:streamdeck": "MYNAH_SD_ENTRY=plugin vite build --config streamdeck/vite.config.ts && MYNAH_SD_ENTRY=inspector vite build --config streamdeck/vite.config.ts",
    "build:lang": "vite build --config vite.lang.config.ts",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/w3c-web-hid": "^1.0.6",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
